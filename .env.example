# ==============================================================================
# CURATION KITCHEN - PRODUCTION ENVIRONMENT SCHEMA
# ==============================================================================
# Copy this file to .env and provide your secrets/configuration values.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment ('production', 'development', or 'test')
NODE_ENV=production

# Server port to bind Express & Vite middlewares
PORT=3000

# Base URL where this applet is hosted (Cloud Run service URL or production domain)
# Used for canonical routing, self-referential links, OAuth callbacks, and API proxies
APP_URL="https://example.com"

# ------------------------------------------------------------------------------
# 2. ARTIFICIAL INTELLIGENCE (GEMINI API)
# ------------------------------------------------------------------------------
# Google Gemini API Key (managed automatically by AI Studio server capability)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. EXTERNAL FOOD APIs & USER AGENT
# ------------------------------------------------------------------------------
OPEN_FOOD_FACTS_USER_AGENT="CurationKitchenApp/1.0.0"

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite:///./data/kitchen.db"

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT INTEGRATION (Optional)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_placeholder"

# ------------------------------------------------------------------------------
# 6. CI/CD & REPOSITORY DEPLOYMENT
# ------------------------------------------------------------------------------
GITHUB_REPO_URL="https://github.com/Ace2a/curation-kitchen-app.git"
GITHUB_TOKEN=""
