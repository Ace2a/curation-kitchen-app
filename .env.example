# ==============================================================================
# CURATION KITCHEN - PRODUCTION ENVIRONMENT SCHEMA
# ==============================================================================
# Copy this file to .env and provide your secrets/configuration values.
# Do NOT commit actual secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment ('production', 'development', or 'test')
NODE_ENV=production

# Server port to bind Express & Vite middlewares
PORT=3000

# Base URL where this applet is hosted (Cloud Run service URL or production domain)
# Used for canonical routing, self-referential links, OAuth callbacks, and API proxies
APP_URL="https://example.com"

# ------------------------------------------------------------------------------
# 2. ARTIFICIAL INTELLIGENCE (GEMINI API)
# ------------------------------------------------------------------------------
# Google Gemini API Key: Required for the AI Auto-Plan Recipe Engine,
# smart pantry expiry predictions, and OCR/UPC product fallbacks.
# In AI Studio, this is injected automatically from the Secrets panel.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. EXTERNAL FOOD APIs & USER AGENT
# ------------------------------------------------------------------------------
# User-Agent string sent to Open Food Facts API v2 and external barcode lookups
# Required by Open Food Facts terms of service for responsible API consumption.
OPEN_FOOD_FACTS_USER_AGENT=CurationKitchenApp/1.0.0

# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Connection string or local database file path for kitchen records,
# recipe cache, pantry inventory, and meal plans.
DATABASE_URL=sqlite:///./data/kitchen.db

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT INTEGRATION
# ------------------------------------------------------------------------------
# Secret key for server-side Stripe checkout and subscription management
STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret for validating incoming Stripe webhook events
STRIPE_WEBHOOK_SECRET="whsec_..."

# Product / Price ID for Curation Kitchen Premium Monthly Subscription
STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_..."

# ------------------------------------------------------------------------------
# 6. CI/CD & REPOSITORY DEPLOYMENT
# ------------------------------------------------------------------------------
# Target Git repository URL for the automated secure push pipeline
GITHUB_REPO_URL="https://github.com/Ace2a/curation-kitchen-app.git"

# GitHub Personal Access Token (PAT) with repo write permissions
GITHUB_TOKEN="PASTE_YOUR_COPIED_TOKEN_HERE"
